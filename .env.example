# 選擇一個相容 OpenAI API 格式的端點，並在本機填入自己的 API 金鑰。

# Gemini 範例
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-3.5-flash-lite
# API_KEY=

# RAG embedding 模型；空白的 URL 和金鑰會沿用上面的聊天模型設定。
EMBEDDING_MODEL_NAME=Embedding
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# 若使用 Gemini，改為：EMBEDDING_MODEL_NAME=gemini-embedding-001
